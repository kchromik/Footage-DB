# ---------------------------------------------------------------
# FootageDB Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.
# ---------------------------------------------------------------

# Port, unter dem die Weboberflaeche erreichbar ist
FDB_PORT=8080

# Pfad zum B-Roll-Ordner auf dem Host (NAS-Freigabe)
# Beispiel Ugreen/UGOS: /volume1/BRoll
FDB_MEDIA_PATH=./testmedia

# Pfad fuer Datenbank, Thumbnails, Proxies und Modelle
FDB_DATA_PATH=./data

# Login. Beides kann leer bleiben, dann fragt der Einrichtungsassistent beim
# ersten Aufruf danach. Solange kein Passwort gesetzt ist, ist die Oberflaeche
# ohne Anmeldung erreichbar, richte sie also gleich nach dem Start ein.
FDB_AUTH_USER=kevin
FDB_AUTH_PASSWORD=

# Zufaelliger Schluessel fuer Session-Cookies
# Erzeugen mit: openssl rand -hex 32
FDB_SECRET_KEY=bitte-mit-openssl-rand-hex-32-erzeugen

# Benutzer- und Gruppen-ID, mit der Dateien geschrieben werden.
# Auf dem NAS auf den eigenen Benutzer setzen, damit Uploads die
# richtigen Rechte bekommen. Herausfinden mit: id -u && id -g
PUID=1000
PGID=1000
TZ=Europe/Berlin

# ---------------------------------------------------------------
# Optionale Feineinstellungen
# ---------------------------------------------------------------

# Anzahl paralleler Hintergrund-Worker (Metadaten, Thumbnails, Proxies).
# Beim Erst-Scan hoeher setzen, danach 2 reicht.
FDB_WORKER_COUNT=2

# Hoehe der Browser-Proxies in Pixeln (720 = 720p)
FDB_PROXY_HEIGHT=720

# Qualitaet der Proxies, kleiner ist besser und groesser
FDB_PROXY_CRF=26

# Hardware-Encoding: auto, vaapi oder off
FDB_HWACCEL=auto

# Semantische Suche (CLIP). Beim ersten Start werden rund 600 MB
# Modelldaten nach FDB_DATA_PATH/models geladen.
FDB_SEMANTIC_ENABLED=true

# Automatischer Rescan des Quellordners in Minuten (0 = aus)
FDB_RESCAN_INTERVAL_MINUTES=60

# Neue Uploads automatisch nach Jahr/Monat/Kamera einsortieren
FDB_ORGANIZE_UPLOADS=true

# Ordnerschema. Platzhalter: {year} {month} {camera} {ext}
FDB_ORGANIZE_PATTERN={year}/{year}-{month}/{camera}

# Log-Level: DEBUG, INFO, WARNING
FDB_LOG_LEVEL=INFO
